{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:sync": "tsx scripts/sync-db.ts",
    "db:sync:force": "tsx scripts/sync-db.ts --force",
    "comments": "tsx scripts/moderate-comments.ts",
    "embeddings": "tsx scripts/build-embeddings.ts",
    "broadcast": "tsx scripts/broadcast.ts",
    "prune:limits": "tsx scripts/prune-rate-limits.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@libsql/client": "^0.18.0",
    "@react-email/components": "^1.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.1",
    "lucide-react": "^1.68.0",
    "mermaid": "11.17.2",
    "motion": "^13.1.1",
    "next": "16.4.5",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^26",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^25.16.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "mermaid": "11.17.2",
      "nanoid@<3.3.8": "^3.3.8",
      "lodash-es@<4.18.0": "^4.18.1",
      "nanoid@>=4.0.0 <5.1.16": "^5.1.16",
      "dompurify@<3.4.17": "^3.4.17",
      "source-map-js@<1.2.2": "^1.2.2",
      "katex@<0.18.2": "^0.18.4",
      "@react-email/render": "^2.2.0"
    },
    "patchedDependencies": {
      "@excalidraw/mermaid-to-excalidraw@2.2.2": "patches/@excalidraw__mermaid-to-excalidraw@2.2.2.patch"
    }
  }
}
