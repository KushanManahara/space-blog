# ==============================================================================
# Space - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development, and add these
# variables to your Vercel Project Settings under "Environment Variables".

# ------------------------------------------------------------------------------
# 1. Database (Turso / LibSQL) [REQUIRED IN PRODUCTION]
# ------------------------------------------------------------------------------
# In production on Vercel, serverless functions require a remote Turso database
# to persist views, likes, comments, contact messages, and newsletter subscribers.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ------------------------------------------------------------------------------
# 2. Email Delivery (Resend) [REQUIRED FOR EMAILS]
# ------------------------------------------------------------------------------
# Required for sending welcome emails, contact notifications, and newsletter broadcasts.
RESEND_API_KEY="re_your_resend_api_key_here"

# ------------------------------------------------------------------------------
# 3. Public Site URL [RECOMMENDED]
# ------------------------------------------------------------------------------
# Used for SEO canonical URLs, sitemap.xml, RSS feed links, and unsubscribe links.
# Defaults to "https://space.gimhara.com" if not set.
NEXT_PUBLIC_SITE_URL="https://space.gimhara.com"

# ------------------------------------------------------------------------------
# 4. Contact & Notification Emails [RECOMMENDED]
# ------------------------------------------------------------------------------
# Email address where you receive submissions from the /contact page.
CONTACT_TO_EMAIL="hi@gimhara.com"

# Sender addresses (must be configured on a verified domain in your Resend account).
# Defaults to "Space <newsletter.space@gimhara.com>" if not set.
NEWSLETTER_FROM_EMAIL="Space <newsletter.space@gimhara.com>"
CONTACT_FROM_EMAIL="Space <newsletter.space@gimhara.com>"

# Signs newsletter unsubscribe links so a URL cannot be edited to unsubscribe
# someone else. Required for outbound email to be enabled at all.
# Generate with: openssl rand -base64 32
NEWSLETTER_SECRET=

# ------------------------------------------------------------------------------
# Portfolio feed CORS [OPTIONAL]
# ------------------------------------------------------------------------------
# Comma-separated origins allowed to call /api/public/posts from a browser.
# Not needed if the portfolio fetches server-side.
PORTFOLIO_ORIGIN="https://your-portfolio.example.com"

# ------------------------------------------------------------------------------
# Studio broadcast [OPTIONAL]
# ------------------------------------------------------------------------------
# Shared secret for broadcastArticleAction. Leave unset to refuse all broadcasts.
STUDIO_SECRET=
